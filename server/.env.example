# Copy to .env and edit. Never commit the real file.
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./skillmatch.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/skillmatch
ALLOWED_EMAIL_DOMAIN=strathmore.edu

# Email (leave SMTP_HOST empty in development: codes are printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SkillMatch <no-reply@example.com>

# Development only: include the one-time code in the API response so you can demo without email
DEV_ECHO_OTP=0

# Hosts without a shell: create the admin and the sample listings when the server starts
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=0

# tfidf (default, no downloads) or sbert (needs sentence-transformers and a model download)
EMBEDDER=tfidf
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
